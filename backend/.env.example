# Copy to .env and fill in. Used by uvicorn when loading backend/main.py
ANTHROPIC_API_KEY=
# Optional — override if your account uses a different Messages API model id
# ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional — model for POST /api/visualize/scene only (falls back to ANTHROPIC_MODEL)
# ANTHROPIC_MODEL_VISUALIZE=claude-opus-4-7
#
# Source of truth (PDF books): for OCR fallback on scanned pages, install Tesseract on the host.
# macOS: brew install tesseract   |   Ubuntu: apt-get install tesseract-ocr
